{
  "name": "parkiran-agent",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "relay",
    "server",
    "web"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p web/tsconfig.node.json --noEmit",
    "install-hooks": "bun scripts/install-hooks.ts",
    "uninstall-hooks": "bun scripts/uninstall-hooks.ts",
    "bench:relay": "bun scripts/bench-relay.ts",
    "server": "bun server/src/index.ts",
    "server:dev": "bun --watch server/src/index.ts",
    "simulate": "bun scripts/simulate.ts",
    "web": "cd web && bun run dev",
    "web:build": "cd web && bun run build",
    "assets:fetch": "bun scripts/assets/fetch.ts",
    "assets:build": "bun scripts/assets/build.ts",
    "assets:pack": "bun scripts/assets/archive.ts pack",
    "assets:character": "bun scripts/assets/character.ts",
    "assets": "bun scripts/assets/fetch.ts && bun scripts/assets/build.ts && bun scripts/assets/archive.ts pack",
    "postinstall": "bun scripts/assets/archive.ts unpack"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/bun": "1.4.2",
    "@types/suncalc": "^1.9.2",
    "ktx2-encoder": "0.6.0",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "suncalc": "1.9.0",
    "typescript": "7.0.2"
  }
}
