# Created by `bun run install-hooks` (mode 600). Never commit the real .env.
# The first three lines are written for you; everything below them is optional and shows the default.
PARKIRAN_TOKEN=<random 64 hex chars>
PARKIRAN_PORT=4747
# Absolute path of git, only spawned for repositories in the reftable format.
PARKIRAN_GIT=/opt/homebrew/bin/git

# Where the lot is, for the sun (the clock always reads your local time).
# PARKIRAN_LAT=-6.2
# PARKIRAN_LON=106.8

# Idle minutes before a character dozes off; hours without events before a session leaves.
# PARKIRAN_IDLE_MINUTES=30
# PARKIRAN_REAP_HOURS=12

# Vite dev server port, extra WebSocket origins (comma separated), what the server serves at /.
# PARKIRAN_WEB_PORT=4748
# PARKIRAN_ALLOWED_ORIGINS=
# PARKIRAN_STATIC_DIR=web/dist

# Relay debugging (local files under logs/, off by default)
PARKIRAN_RELAY_DEBUG=0
PARKIRAN_RELAY_RAW=0
